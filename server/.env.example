# Copy to .env and fill in. Never commit the real .env.
PORT=4000

# --- SQL Server -------------------------------------------------------------
# Windows Authentication: set DB_SERVER and leave DB_USER empty (local Windows dev).
# SQL Authentication:     set DB_USER and DB_PASSWORD (Linux / Docker / remote).
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=expense_tracker
DB_USER=
DB_PASSWORD=
# DB_PORT=1433
# DB_ENCRYPT=false
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# --- Auth ---------------------------------------------------------------------
# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
TOKEN_TTL=7d

# First admin account, created by "npm run setup-db" only when no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# CORS_ORIGIN=http://localhost:5173
