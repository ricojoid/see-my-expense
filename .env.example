# Settings for docker compose. Copy to .env next to docker-compose.yml and fill in.
# Never commit the real .env. Avoid "$" and spaces in values.

# Port the app is published on (http://your-server:8080).
APP_PORT=8080

# ---- Database: an existing SQL Server ----
# host.docker.internal = the Docker host itself, so a SQL Server container that
# publishes port 1433 on the host (e.g. "0.0.0.0:1433->1433") works as is.
DB_SERVER=host.docker.internal
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
# Created on first start if it doesn't exist.
DB_DATABASE=expense_tracker

# ---- Or: let compose run its own SQL Server ----
# Uncomment the next line and set DB_SERVER=db (DB_PASSWORD becomes its "sa" password).
# COMPOSE_FILE=docker-compose.yml:docker-compose.db.yml

# Random string, 32+ characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# First admin account, created on the first start only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# TOKEN_TTL=7d

# Contact shown to push services for notifications (optional).
# VAPID_SUBJECT=mailto:you@yourdomain.com
