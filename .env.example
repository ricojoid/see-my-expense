# Settings for docker compose. Copy to .env next to docker-compose.yml and fill in.
# Never commit the real .env.

# Port the app is published on (http://your-server:8080).
APP_PORT=8080

# SQL Server "sa" password. Must be 8+ characters with upper case, lower case,
# digits and/or symbols, or SQL Server refuses to start.
MSSQL_SA_PASSWORD=

# Random string, 32+ characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# First admin account, created on the first start only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# DB_DATABASE=expense_tracker
# TOKEN_TTL=7d
